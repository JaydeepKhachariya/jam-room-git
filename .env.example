# Supabase project settings → API Keys (https://supabase.com/dashboard).
# Copy to .env.local for local dev, and add the same three to Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…, or the legacy anon key). Safe in browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, or the legacy service_role key). Server only:
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
